# Copy to dash.conf next to dash.sh on the Kindle and edit.

# Full URL of the rendered PNG. Always the IP and port, even when the server also has a nice HTTPS
# name: the Kindle has no mDNS resolver and its CA bundle is too old to validate a modern cert.
DASH_URL="http://192.168.1.50:6800/api/dash.png"

# Seconds between refreshes
INTERVAL=300

# Do a full flashing refresh every N cycles, to clear e-ink ghosting
FULL_REFRESH_EVERY=12

# 1 = suspend the device between refreshes (big battery win, test the loop first)
SUSPEND=0

# 1 = stop the Kindle UI while the dashboard runs
STOP_FRAMEWORK=0

# 1 = two power presses within POWER_EXIT_WINDOW seconds stop the dashboard and restore the UI.
# The only way out from the device itself once the UI is stopped, short of a reboot.
POWER_EXIT=1
POWER_EXIT_WINDOW=6
