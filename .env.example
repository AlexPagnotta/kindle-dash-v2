# Host port the dashboard is served on
DASH_PORT=3000

# Timezone used for every date on the dashboard
DASH_TZ=Europe/Rome

# Dashboard size, in physical pixels. The Kindle sits in landscape.
SCREEN_WIDTH=800
SCREEN_HEIGHT=600

# Rotation applied to the rendered PNG, so it matches the portrait framebuffer.
# 270 if it comes out upside down, 0 if you rotate the framebuffer on the device instead.
DASH_ROTATE=90

# How long a rendered PNG stays valid, and how often the prerender job runs (ms)
DASH_TTL_MS=300000
